<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🚀 Ultra File Uploader - Premium & Unlimited</title>
  <!-- Google Fonts: Plus Jakarta Sans & Space Grotesk -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0PzGcASaYj0K3N2b5eYySjRzXF5O5dC+2/2hIeGzCgL8f5d0l+z5gR8w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    /* Premium CSS Variables - Aurora Neon Dark Mode */
    :root {
      --primary: #8b5cf6; /* Royal Violet */
      --primary-rgb: 139, 92, 246;
      --secondary: #ec4899; /* Hot Pink */
      --secondary-rgb: 236, 72, 153;
      --accent: #06b6d4; /* Neon Cyan */
      --accent-rgb: 6, 182, 212;
      --bg: #030712;
      --card-bg: rgba(17, 24, 39, 0.55);
      --card-border: rgba(255, 255, 255, 0.08);
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --success: #10b981;
      --success-rgb: 16, 185, 129;
      --error: #ef4444;
      --error-rgb: 239, 68, 68;
      --font-display: 'Space Grotesk', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
    }

    /* Reset & Base Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(139, 92, 246, 0.15) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(236, 72, 153, 0.15) 0px, transparent 50%),
        radial-gradient(at 50% 100%, rgba(6, 182, 212, 0.1) 0px, transparent 50%);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      position: relative;
    }

    /* Floating Aurora Blobs (Animations) */
    .aurora-container {
      position: absolute;
      width: 100vw;
      height: 100vh;
      top: 0;
      left: 0;
      overflow: hidden;
      z-index: 0;
      pointer-events: none;
    }

    .aurora-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(140px);
      opacity: 0.35;
      mix-blend-mode: screen;
      animation: floatBlob 25s infinite alternate ease-in-out;
    }

    .blob-1 {
      width: 450px;
      height: 450px;
      background: var(--primary);
      top: -10%;
      left: -10%;
      animation-duration: 22s;
    }

    .blob-2 {
      width: 500px;
      height: 500px;
      background: var(--secondary);
      bottom: -15%;
      right: -10%;
      animation-duration: 28s;
    }

    .blob-3 {
      width: 350px;
      height: 350px;
      background: var(--accent);
      top: 40%;
      left: 60%;
      animation-duration: 18s;
    }

    @keyframes floatBlob {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); }
      50% { transform: translate(60px, -40px) scale(1.15) rotate(180deg); }
      100% { transform: translate(-40px, 50px) scale(0.9) rotate(360deg); }
    }

    /* Keyframe Animations */
    @keyframes cardEntrance {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 20px rgba(139, 92, 246, 0.15); }
      50% { box-shadow: 0 0 35px rgba(139, 92, 246, 0.3); }
    }

    /* Container Glassmorphism Card */
    .container {
      background: var(--card-bg);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      padding: 50px 45px;
      border-radius: 24px;
      border: 1px solid var(--card-border);
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.5);
      text-align: center;
      max-width: 580px;
      width: 92%;
      z-index: 10;
      position: relative;
      animation: cardEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      overflow: hidden;
    }

    .container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
    }

    /* Page Title */
    h1 {
      font-family: var(--font-display);
      font-size: 2.3em;
      font-weight: 700;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #ffffff 30%, #a78bfa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    h1 i {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.4));
    }

    /* Premium Alert Styles (Frosted Glass Glassmorphism) */
    .alert {
      padding: 16px 20px;
      border-radius: 14px;
      margin-bottom: 28px;
      font-size: 0.95em;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      word-break: break-all;
      text-align: left;
      animation: slideInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      border: 1px solid transparent;
      backdrop-filter: blur(8px);
    }

    .alert-success {
      background: rgba(16, 185, 129, 0.12);
      border-color: rgba(16, 185, 129, 0.25);
      color: #34d399;
      box-shadow: 0 8px 20px -5px rgba(16, 185, 129, 0.15);
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.12);
      border-color: rgba(239, 68, 68, 0.25);
      color: #fca5a5;
      box-shadow: 0 8px 20px -5px rgba(239, 68, 68, 0.15);
    }

    .alert i {
      font-size: 1.25em;
      margin-top: 2px;
    }

    .file-url-link {
      color: var(--accent);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .file-url-link:hover {
      color: #22d3ee;
      text-decoration: underline;
    }

    /* Advanced Drag & Drop Zone */
    .upload-zone {
      border: 2px dashed rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.02);
      padding: 40px 30px;
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
      margin-bottom: 25px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 200px;
    }

    .upload-zone::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      padding: 2px;
      background: linear-gradient(135deg, var(--primary), var(--secondary), var(--accent));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .upload-zone:hover {
      border-color: transparent;
      background: rgba(255, 255, 255, 0.04);
      transform: translateY(-2px);
    }

    .upload-zone:hover::before {
      opacity: 0.6;
    }

    .upload-zone.drag-over {
      border-color: transparent;
      background: rgba(139, 92, 246, 0.08);
      animation: pulseGlow 2s infinite ease-in-out;
    }

    .upload-zone.drag-over::before {
      opacity: 1;
    }

    .upload-zone input[type="file"] {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      opacity: 0;
      cursor: pointer;
      z-index: 10;
    }

    .upload-zone .icon {
      font-size: 3.5em;
      background: linear-gradient(135deg, #c084fc, #f472b6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 18px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      filter: drop-shadow(0 4px 10px rgba(139, 92, 246, 0.2));
    }

    .upload-zone:hover .icon {
      transform: translateY(-8px) scale(1.08);
      filter: drop-shadow(0 6px 15px rgba(139, 92, 246, 0.35));
    }

    .upload-zone p {
      margin: 0;
      font-size: 1.15em;
      color: var(--text-main);
      font-weight: 600;
      letter-spacing: -0.2px;
    }

    .upload-zone span {
      font-size: 0.9em;
      color: var(--text-muted);
      margin-top: 6px;
    }

    /* Premium File Preview Area */
    .file-preview-area {
      margin-top: 15px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 16px;
      text-align: left;
      opacity: 0;
      max-height: 0;
      overflow: hidden;
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .file-preview-area.show {
      opacity: 1;
      max-height: 110px;
      padding: 16px;
      margin-bottom: 25px;
    }

    .file-preview-area img {
      width: 58px;
      height: 58px;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background-color: rgba(0, 0, 0, 0.2);
    }

    .file-preview-area .preview-info {
      flex-grow: 1;
      min-width: 0; /* Hindari overflow teks */
    }

    .file-preview-area .file-name {
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
      font-size: 0.95em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .file-preview-area .file-size {
      font-size: 0.85em;
      color: var(--text-muted);
    }

    .file-preview-area .remove-file {
      background: rgba(239, 68, 68, 0.1);
      border: none;
      color: var(--error);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1em;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .file-preview-area .remove-file:hover {
      background: var(--error);
      color: white;
      transform: scale(1.1) rotate(90deg);
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    /* Futuristic Submit Button */
    .submit-button {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      padding: 16px 30px;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      font-family: var(--font-display);
      font-size: 1.1em;
      font-weight: 700;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      width: 100%;
      letter-spacing: 0.5px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.4);
    }

    .submit-button::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transform: translateX(-100%);
      transition: transform 0.6s ease;
    }

    .submit-button:hover:not(:disabled)::after {
      transform: translateX(100%);
    }

    .submit-button:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 15px 30px -5px rgba(139, 92, 246, 0.5), 0 0 15px rgba(236, 72, 153, 0.2);
    }

    .submit-button:active:not(:disabled) {
      transform: translateY(1px);
      box-shadow: 0 5px 15px -5px rgba(139, 92, 246, 0.4);
    }

    .submit-button:disabled {
      background: rgba(255, 255, 255, 0.08);
      color: rgba(255, 255, 255, 0.25);
      cursor: not-allowed;
      box-shadow: none;
    }

    /* Circular Spinner */
    .spinner {
      border: 3px solid rgba(255, 255, 255, 0.15);
      border-top: 3px solid #ffffff;
      border-radius: 50%;
      width: 22px;
      height: 22px;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    .submit-button.loading .spinner {
      display: block;
    }

    .submit-button.loading span {
      display: none;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Bottom Navigation Link */
    .bottom-nav {
      margin-top: 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 24px;
    }

    .bottom-nav a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95em;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .bottom-nav a::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 1.5px;
      bottom: -3px;
      left: 0;
      background: linear-gradient(90deg, var(--accent), var(--primary));
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    .bottom-nav a:hover {
      color: #e2e8f0;
    }

    .bottom-nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    /* Custom Responsive Styles */
    @media (max-width: 600px) {
      .container {
        padding: 35px 25px;
        margin: 16px;
      }
      h1 {
        font-size: 1.9em;
      }
      .upload-zone {
        padding: 30px 20px;
        min-height: 170px;
      }
      .upload-zone p {
        font-size: 1.05em;
      }
      .submit-button {
        padding: 14px 20px;
        font-size: 1em;
      }
    }
  </style>
</head>
<body>
  <!-- Aurora Glow Blobs in Background -->
  <div class="aurora-container">
    <div class="aurora-blob blob-1"></div>
    <div class="aurora-blob blob-2"></div>
    <div class="aurora-blob blob-3"></div>
  </div>

  <div class="container">
    <h1><i class="fas fa-cloud-upload-alt"></i> Upload Anything</h1>

    <% if (msg) { %>
      <div class="alert <%= msg.includes('sukses') ? 'alert-success' : 'alert-error' %>" role="alert">
        <i class="fas <%= msg.includes('sukses') ? 'fa-check-circle' : 'fa-exclamation-triangle' %>"></i>
        <div>
          <%= msg %>
          <% if (file) { %>
            <br><span class="file-url">URL: <a href="<%= file %>" target="_blank" class="file-url-link"><%= file %> <i class="fas fa-external-link-alt" style="font-size: 0.8em;"></i></a></span>
          <% } %>
        </div>
      </div>
    <% } %>

    <form action="/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
      <!-- Drag & Drop Zone -->
      <div class="upload-zone" id="dropZone">
        <input type="file" name="file" id="fileInput" />
        <i class="fas fa-file-upload icon"></i>
        <p>Seret & Lepas File di Sini</p>
        <span>atau Klik untuk Memilih File</span>
      </div>

      <!-- Area Preview File -->
      <div class="file-preview-area" id="filePreviewArea">
        <img src="" alt="File Preview" id="previewImage">
        <div class="preview-info">
          <div class="file-name" id="previewFileName"></div>
          <div class="file-size" id="previewFileSize"></div>
        </div>
        <button type="button" class="remove-file" id="removeFileButton"><i class="fas fa-times-circle"></i></button>
      </div>

      <!-- Tombol Upload -->
      <button type="submit" class="submit-button" id="submitButton" disabled>
        <span id="buttonText">Upload Sekarang</span>
        <div class="spinner" id="buttonSpinner"></div>
      </button>
    </form>

    <div style="margin-top: 25px; border-top: 1px solid var(--border-color); padding-top: 20px;">
      <a href="/files" style="color: var(--primary-color); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
        <i class="fas fa-list-ul"></i> Lihat Semua File Terunggah
      </a>
    </div>
  </div>

  <script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const filePreviewArea = document.getElementById('filePreviewArea');
    const previewImage = document.getElementById('previewImage');
    const previewFileName = document.getElementById('previewFileName');
    const previewFileSize = document.getElementById('previewFileSize');
    const removeFileButton = document.getElementById('removeFileButton');
    const submitButton = document.getElementById('submitButton');
    const buttonText = document.getElementById('buttonText');
    const buttonSpinner = document.getElementById('buttonSpinner');
    const uploadForm = document.getElementById('uploadForm');

    // Menghindari perilaku default browser untuk drag & drop
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, preventDefaults, false);
      document.body.addEventListener(eventName, preventDefaults, false); // Untuk seluruh body
    });

    function preventDefaults (e) {
      e.preventDefault();
      e.stopPropagation();
    }

    // Efek highlight saat file di-drag ke atas zona
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, unhighlight, false);
    });

    function highlight(e) {
      dropZone.classList.add('drag-over');
    }

    function unhighlight(e) {
      dropZone.classList.remove('drag-over');
    }

    // Menangani file yang di-drop
    dropZone.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
      const dt = e.dataTransfer;
      const files = dt.files;
      handleFiles(files);
    }

    // Menangani file yang dipilih lewat input biasa
    fileInput.addEventListener('change', (e) => {
      handleFiles(e.target.files);
    });

    // Fungsi utama untuk memproses file yang dipilih
    function handleFiles(files) {
      if (files.length > 0) {
        const file = files[0];
        displayFile(file); // Tampilkan preview
        // Set file ke elemen input agar bisa disubmit
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        fileInput.files = dataTransfer.files;
        submitButton.disabled = false; // Aktifkan tombol upload
      } else {
        resetFileSelection(); // Reset jika tidak ada file
      }
    }

    // Menampilkan informasi dan preview file
    function displayFile(file) {
      previewFileName.textContent = file.name;
      previewFileSize.textContent = formatBytes(file.size);

      // Cek jika file adalah gambar, tampilkan preview gambar
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (e) => {
          previewImage.src = e.target.result;
          previewImage.style.display = 'block';
        };
        reader.readAsDataURL(file);
      } else {
        previewImage.style.display = 'none'; // Sembunyikan jika bukan gambar
        // Bisa tambahkan ikon default untuk tipe file lain di sini (misal: PDF, DOC)
        // Untuk sekarang, kita biarkan kosong jika bukan gambar
      }
      filePreviewArea.classList.add('show'); // Tampilkan area preview
    }

    // Menghapus file yang dipilih
    removeFileButton.addEventListener('click', () => {
      resetFileSelection();
    });

    function resetFileSelection() {
      fileInput.value = ''; // Hapus nilai input file
      filePreviewArea.classList.remove('show'); // Sembunyikan area preview
      // Beri sedikit delay sebelum menghapus src agar transisi lebih mulus
      setTimeout(() => {
        previewImage.src = '';
        previewFileName.textContent = '';
        previewFileSize.textContent = '';
      }, 400); // Sesuaikan dengan durasi transisi .file-preview-area
      submitButton.disabled = true; // Nonaktifkan tombol upload
    }

    // Format ukuran byte biar lebih mudah dibaca
    function formatBytes(bytes, decimals = 2) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    // Animasi saat form disubmit (simulasi loading)
    uploadForm.addEventListener('submit', () => {
      submitButton.disabled = true;
      submitButton.classList.add('loading'); // Tampilkan spinner
    });

    // Cek kondisi awal saat halaman dimuat (misal setelah refresh ada pesan error/success)
    document.addEventListener('DOMContentLoaded', () => {
      if (<%= msg ? 'true' : 'false' %>) {
        // Jika ada pesan, tombol upload tetap nonaktif sampai user pilih file baru
        submitButton.disabled = true;
      } else {
        // Jika tidak ada pesan, tombol upload nonaktif sampai user pilih file
        submitButton.disabled = true;
      }
    });
  </script>
</body>
</html>
